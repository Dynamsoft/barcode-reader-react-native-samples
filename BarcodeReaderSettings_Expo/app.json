{
  "expo": {
    "name": "BarcodeReaderSettings_Expo",
    "slug": "BarcodeReaderSettings_Expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.dynamsoft.BarcodeReaderSettings",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to scan barcodes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dynamsoft.BarcodeReaderSettings"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "cmakeVersion": "3.31.6",
            "extraMavenRepos": [
              "https://download2.dynamsoft.com/maven/aar"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
