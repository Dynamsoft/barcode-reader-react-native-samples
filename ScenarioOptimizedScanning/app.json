{
  "expo": {
    "name": "ScenarioOptimizedScanning",
    "slug": "ScenarioOptimizedScanning",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dynamsoft.ScenarioOptimizedScanning",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to scan barcodes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dynamsoft.ScenarioOptimizedScanning"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "dynamsoft-capture-vision-react-native",
      "./plugins/withShortCmakePath.js"
    ]
  }
}
